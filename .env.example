# Replit supplies DATABASE_URL for the app's PostgreSQL database.
DATABASE_URL=

# Replit-managed Clerk supplies these values to the app automatically.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# The platform API uses its own database and an explicit Clerk subject allowlist.
# Do not point this at DATABASE_URL or expose it to the browser.
PLATFORM_DATABASE_URL=
PLATFORM_ADMIN_CLERK_IDS=

# Operator-only local gym linking/activation. Keep server-side.
GYM_SOURCE_DATABASE_URL=

# Operator-only provisioning CLI settings. Never configure these in the frontend.
GYM_PROVISION_ADMIN_URL=
GYM_PROVISION_TENANT_URL=
GYM_PROVISION_OWNER_ROLE=

# Comma-separated Clerk authorized-party values. Include the native app's
# Clerk Frontend API Origin when the request has no browser Origin header.
CLERK_AUTHORIZED_PARTIES=

# Pin member API requests to one active existing gym in the platform registry.
# This server-side setting is required; the mobile app cannot choose a gym.
MEMBER_PORTAL_GYM_ID=

# Verified Clerk email allowed to bootstrap the first owner account.
INITIAL_OWNER_EMAIL=

# Private file storage (outside the frontend's public/static directories).
# Use a persistent volume path for deployed environments.
MYGYM_UPLOAD_DIR=.data/mygym-uploads
