# Replit supplies DATABASE_URL for the app's PostgreSQL database.
DATABASE_URL=

# Replit-managed Clerk supplies these values to the app automatically.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Verified Clerk email allowed to bootstrap the first owner account.
INITIAL_OWNER_EMAIL=

# Private file storage (outside the frontend's public/static directories).
# Use a persistent volume path for deployed environments.
MYGYM_UPLOAD_DIR=.data/mygym-uploads
